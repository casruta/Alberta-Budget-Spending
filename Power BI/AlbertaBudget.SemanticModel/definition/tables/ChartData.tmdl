/// One source-backed observation per ChartId, Panel, Period and Series. No relationships to duplicated source evidence.
table 'ChartData'
	lineageTag: ad601dd1-eaa0-552b-81e9-73198136a627

	measure 'Chart value' = IF(COUNTROWS(ChartData) = 1, MAX(ChartData[Value]), BLANK())
		formatString: #,0.00
		lineageTag: 62f972d7-97d3-5faf-a735-531b1f6fd482
		formatStringDefinition = SWITCH(SELECTEDVALUE(ChartData[Unit]), "Fiscal-start year", "0", "Incidents per 100,000", "#,0", "Units + households", "#,0", "CAD millions", "#,0", "CAD per resident", "#,0", "2024 CAD per resident", "#,0", "CAD per week", "#,0", "#,0.00")

	measure 'Point Unit' = SELECTEDVALUE(ChartData[Unit])
		lineageTag: 6fc19d60-9720-5060-85c4-ff6c0c17d438

	measure 'Point ObservationKind' = SELECTEDVALUE(ChartData[ObservationKind])
		lineageTag: ecdcd92a-d30d-5bd6-bf52-9aa2f7bbe7dc

	measure 'Point Status' = SELECTEDVALUE(ChartData[Status])
		lineageTag: 8d553571-f1c0-58c0-a449-45f59a11704d

	measure 'Point SourceRows' = SELECTEDVALUE(ChartData[SourceRows])
		lineageTag: b9e82263-b70b-54dc-8b47-07f34b50af51

	measure 'Point Transformation' = SELECTEDVALUE(ChartData[Transformation])
		lineageTag: 398c715c-81ba-5871-a4a1-920b9217ab0c

	column 'ChartId'
		dataType: string
		lineageTag: 1e68de36-f7e2-55f9-831b-ab45b4d8a14f
		summarizeBy: none
		sourceColumn: ChartId

	column 'Panel'
		dataType: string
		lineageTag: 54fd2bfe-080c-5074-b775-ac5d88628f17
		summarizeBy: none
		sourceColumn: Panel

	column 'Period'
		dataType: string
		lineageTag: d87ff58e-e70c-5d0c-9fca-2e01a4e8ec46
		summarizeBy: none
		sourceColumn: Period

	column 'Series'
		dataType: string
		lineageTag: 88c46b94-f1ed-5856-850e-c84b9fa8f13b
		summarizeBy: none
		sourceColumn: Series

	column 'Value'
		dataType: double
		lineageTag: d4b7658c-dfc6-54e1-84a0-2d9817bb1614
		summarizeBy: none
		sourceColumn: Value
		formatString: #,0.00

	column 'Unit'
		dataType: string
		lineageTag: c28e894c-88cc-59fc-be4a-cdf44b4a972a
		summarizeBy: none
		sourceColumn: Unit

	column 'ObservationKind'
		dataType: string
		lineageTag: b611dda0-3bfb-518e-bcbf-61852e522a42
		summarizeBy: none
		sourceColumn: ObservationKind

	column 'Status'
		dataType: string
		lineageTag: 43d51c27-a6e5-5f01-95e3-81fd80c3d544
		summarizeBy: none
		sourceColumn: Status

	column 'SourcePaths'
		dataType: string
		lineageTag: 79a2e729-e393-5e4a-ad0c-e1a1bac58565
		summarizeBy: none
		sourceColumn: SourcePaths

	column 'SourceRows'
		dataType: string
		lineageTag: 577e1a28-f524-5f05-8795-c148e69a97ae
		summarizeBy: none
		sourceColumn: SourceRows

	column 'SourceFields'
		dataType: string
		lineageTag: f21451ee-7f41-5543-8cb7-6d2475fe84eb
		summarizeBy: none
		sourceColumn: SourceFields

	column 'Transformation'
		dataType: string
		lineageTag: 42787c70-4312-5494-9ebd-8d23173ed316
		summarizeBy: none
		sourceColumn: Transformation

	partition 'ChartData' = m
		mode: import
		source =
			let
				Rows = Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.GZip)),
				Source = Table.FromRows(Rows, {"ChartId", "Panel", "Period", "Series", "Value", "Unit", "ObservationKind", "Status", "SourcePaths", "SourceRows", "SourceFields", "Transformation"}),
				Typed = Table.TransformColumnTypes(Source, {{"ChartId", type text}, {"Panel", type text}, {"Period", type text}, {"Series", type text}, {"Value", type number}, {"Unit", type text}, {"ObservationKind", type text}, {"Status", type text}, {"SourcePaths", type text}, {"SourceRows", type text}, {"SourceFields", type text}, {"Transformation", type text}}, "en-US")
			in
				Typed
