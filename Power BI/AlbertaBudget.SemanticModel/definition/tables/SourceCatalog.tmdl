	partition 'SourceCatalog' = m
		mode: import
		source =
			let
				Rows = Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.GZip)),
				Source = Table.FromRows(Rows, {"SourceId", "Path", "Rows", "Columns", "Role", "ModelTable", "SHA256"}),
				Typed = Table.TransformColumnTypes(Source, {{"SourceId", type text}, {"Path", type text}, {"Rows", Int64.Type}, {"Columns", Int64.Type}, {"Role", type text}, {"ModelTable", type text}, {"SHA256", type text}}, "en-US")
			in
